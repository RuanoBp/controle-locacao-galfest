# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Dashboard do Supabase > Project Settings > API).

# URL do projeto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon" / "publishable" (pública, protegida pelas políticas de RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" (SECRETA — nunca commitar, nunca usar no navegador).
# Usada apenas localmente pelo script scripts/criar-admin.mjs para criar/trocar
# a senha do usuário administrador.
SUPABASE_SERVICE_ROLE_KEY=
